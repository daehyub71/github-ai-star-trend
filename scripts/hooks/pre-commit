#!/bin/sh
# Pre-commit gate (SPEC NFR-14): ruff check -> mypy -> pytest -> size_guard.py --staged
# Enable once per clone:  git config core.hooksPath scripts/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/Scripts/python.exe ]; then
  PY=.venv/Scripts/python.exe
else
  PY=.venv/bin/python
fi
"$PY" -m ruff check .
"$PY" -m mypy startrend tests scripts
"$PY" -m pytest -q
"$PY" scripts/size_guard.py --staged
